# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (or legacy anon) key — safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy service_role) key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Internal identity domain for member accounts. Not a real mailbox; no email is sent.
NEXT_PUBLIC_MEMBER_EMAIL_DOMAIN=members.twosix.invalid

# Random string used to hash client IPs for sign-up rate limiting.
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# IANA time zone for class times (e.g. America/Chicago)
NEXT_PUBLIC_GYM_TIMEZONE=America/New_York

# One-time code for the /setup page that creates the admin (12+ characters).
ADMIN_SETUP_CODE=
